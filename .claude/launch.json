{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "BETTER_AUTH_URL=http://localhost:3100",
        "npm",
        "--prefix",
        "web",
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "web-e2e",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "E2E_OTP=1",
        "BETTER_AUTH_URL=http://localhost:3200",
        "NEXT_DIST_DIR=.next/e2e",
        "npm",
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3200"
      ],
      "port": 3200
    }
  ]
}
