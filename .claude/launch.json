{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "BETTER_AUTH_URL=http://localhost:3100",
        "npm",
        "--prefix",
        "web",
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}