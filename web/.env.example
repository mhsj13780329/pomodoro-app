# Local Postgres from the repo-root docker-compose.yml. Copy this file to .env.local.
DATABASE_URL="postgresql://pomodoro:pomodoro@localhost:5433/pomodoro"

# openssl rand -base64 32 — at least 32 characters. Never commit the real value.
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Origin of this Next.js app. Better Auth sets cookies against it.
BETTER_AUTH_URL="http://localhost:3000"

# Web Push for phase-end notifications (optional; push is off when missing).
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
